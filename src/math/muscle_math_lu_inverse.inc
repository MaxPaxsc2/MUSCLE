!
! Body of the fixed-size LU inverses of muscle_math_inverses (M55INV, M66INV, M99INV and the
! private LU fallbacks lu_inv3, lu_inv4 of M33INV, M44INV).
!
! It is INCLUDEd by subroutines that declare, before the INCLUDE line:
!   integer, parameter :: N             -- matrix size (compile-time constant)
!   real(real64), intent(in)  :: A(N,N) -- matrix to invert
!   real(real64), intent(out) :: AINV(N,N)
!   logical, intent(out)      :: OK_FLAG
! A compile-time N lets the compiler unroll the loops: measured ~20 % faster than a single
! routine with N as an argument for the 6x6 case.
!
! Algorithm (same as LAPACK DGETRF + DGETRI, unblocked, no external calls):
!   1. P A = L U with partial pivoting (column-oriented, like DGETF2);
!   2. inv(U) in place (like DTRTI2, upper, non-unit);
!   3. solve inv(A) L = inv(U) (like DGETRI);
!   4. undo the row interchanges as column interchanges, in reverse order.
! Singular A (exactly zero pivot): OK_FLAG = .false. and AINV = 0.

        integer :: ipiv(N), i, j, k, p
        real(real64) :: r, tmp, ajj, s, work(N)

        AINV = A
        ! --- 1. factorization P A = L U ---
        do k = 1, N
            p = k
            do i = k+1, N
                if (abs(AINV(i,k)) > abs(AINV(p,k))) p = i
            end do
            ipiv(k) = p
            if (.not. (abs(AINV(p,k)) > 0.0D0)) then     ! zero (or NaN) pivot: singular
                OK_FLAG = .false.
                AINV = 0.0D0
                return
            end if
            if (p /= k) then
                do j = 1, N
                    tmp = AINV(k,j); AINV(k,j) = AINV(p,j); AINV(p,j) = tmp
                end do
            end if
            r = 1.0D0 / AINV(k,k)
            do i = k+1, N
                AINV(i,k) = AINV(i,k) * r
            end do
            do j = k+1, N
                do i = k+1, N
                    AINV(i,j) = AINV(i,j) - AINV(i,k) * AINV(k,j)
                end do
            end do
        end do
        ! --- 2. inv(U) in place ---
        do j = 1, N
            AINV(j,j) = 1.0D0 / AINV(j,j)
            ajj = -AINV(j,j)
            do i = 1, j-1
                work(i) = AINV(i,j)
            end do
            do i = 1, j-1
                s = 0.0D0
                do k = i, j-1
                    s = s + AINV(i,k) * work(k)
                end do
                AINV(i,j) = s * ajj
            end do
        end do
        ! --- 3. solve inv(A) L = inv(U) ---
        do j = N-1, 1, -1
            do i = j+1, N
                work(i) = AINV(i,j)
                AINV(i,j) = 0.0D0
            end do
            do k = j+1, N
                do i = 1, N
                    AINV(i,j) = AINV(i,j) - AINV(i,k) * work(k)
                end do
            end do
        end do
        ! --- 4. column interchanges ---
        do j = N-1, 1, -1
            p = ipiv(j)
            if (p /= j) then
                do i = 1, N
                    tmp = AINV(i,j); AINV(i,j) = AINV(i,p); AINV(i,p) = tmp
                end do
            end if
        end do
        OK_FLAG = .true.
